# Required: MongoDB connection string
# Prefer Atlas: run `npm run atlas:bootstrap` (writes mongodb+srv://...)
# Local Docker: mongodb://127.0.0.1:27017/gila-community
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/gila-community?retryWrites=true&w=majority

# Required: JWT secret, at least 32 characters
TOKEN_KEY=replace-with-a-long-random-secret-at-least-32-chars

PORT=4000

# Required in production: public origin of the web app (CORS + Socket.io)
CLIENT_URL=http://127.0.0.1:5173

# Optional: only if the API is on a different host than the Vite/app origin.
# Leave unset in local dev (Vite proxy) and when serving client dist from Express.
# VITE_API_URL=https://api.example.com
